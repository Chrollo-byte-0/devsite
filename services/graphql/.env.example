# URL pública de Strapi (sin slash final)
STRAPI_URL=https://cms.tudominio.com
# API Token de Strapi (Settings > API Tokens, tipo Read-only)
STRAPI_API_TOKEN=
# URL del servicio metrics y token de lectura (para la query siteStats)
METRICS_URL=https://metrics.tudominio.com
METRICS_ADMIN_TOKEN=
# Orígenes permitidos por CORS, separados por coma
CORS_ORIGINS=https://tudominio.com
