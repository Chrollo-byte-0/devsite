# Postgres (Vercel Marketplace > Neon / Supabase, o cualquier Postgres). Usa la URL "pooled".
DATABASE_URL=postgres://user:pass@host/db?sslmode=require
# Hosts cuyas visitas se aceptan, separados por coma (landing y blog comparten dominio)
ALLOWED_HOSTS=tudominio.com,www.tudominio.com
# Token para leer /api/stats (usado por GraphQL y el /admin). openssl rand -hex 32
METRICS_ADMIN_TOKEN=
# Sal para el hash diario de visitantes. openssl rand -hex 16
VISITOR_SALT=
