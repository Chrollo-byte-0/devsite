HOST=0.0.0.0
PORT=1337
PUBLIC_URL=https://cms.tudominio.com
# Genera cada valor con: openssl rand -base64 32   (APP_KEYS: 4 valores separados por coma)
APP_KEYS=
API_TOKEN_SALT=
ADMIN_JWT_SECRET=
TRANSFER_TOKEN_SALT=
ENCRYPTION_KEY=
JWT_SECRET=
# Producción
DATABASE_CLIENT=postgres
DATABASE_URL=postgres://user:pass@host:5432/db
# Orígenes que pueden llamar a la API (sitio web y servicio GraphQL)
CORS_ORIGINS=https://tudominio.com,https://graphql.tudominio.com
